__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
dist/
build/
*.egg-info/
results/raw/*.parquet
results/processed/*.parquet
/results/stage1_2/processed/*/records.parquet
/results/stage1_3/processed/*/records.parquet
/results/stage1_3_dev_*.log
/results/stage1_3_threshold_*.log
# Stage 2C full per-tick tensors/traces remain on the research server and can
# be regenerated from tracked checkpoints, source, and protocol. Compact rows,
# summaries, manifests, and the report remain versioned.
/results/stage2c/**/state_tensors.pt
/results/stage2c/**/trajectory.jsonl
/results/stage2c/trajectories/full/*/windows.jsonl
/results/stage2c/trajectories/full/*/window_states.pt
# Stage 2D.1 high-resolution and curriculum checkpoints/logs are reproducible
# from the tracked seeds, schedules, summaries, and scripts. Keep compact JSON
# audits and adjudication results in Git, but not binary training artifacts.
/results/stage2d1/checkpoints/
/results/stage2d1/curricula/**/*.pt
/results/stage2d1/curricula/**/*.log
