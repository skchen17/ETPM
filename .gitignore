__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
dist/
build/
*.egg-info/
results/raw/*.parquet
results/processed/*.parquet
/results/stage1_2/processed/*/records.parquet
/results/stage1_3/processed/*/records.parquet
/results/stage1_3_dev_*.log
/results/stage1_3_threshold_*.log
# Stage 2C full per-tick tensors/traces remain on the research server and can
# be regenerated from tracked checkpoints, source, and protocol. Compact rows,
# summaries, manifests, and the report remain versioned.
/results/stage2c/**/state_tensors.pt
/results/stage2c/**/trajectory.jsonl
/results/stage2c/trajectories/full/*/windows.jsonl
/results/stage2c/trajectories/full/*/window_states.pt
# Stage 2D.1 high-resolution and curriculum checkpoints/logs are reproducible
# from the tracked seeds, schedules, summaries, and scripts. Keep compact JSON
# audits and adjudication results in Git, but not binary training artifacts.
/results/stage2d1/checkpoints/
/results/stage2d1/curricula/**/*.pt
/results/stage2d1/curricula/**/*.log
# Stage 2D.2 confirmatory checkpoints and process logs are reproducible from
# tracked seeds/protocols; finite response matrices and summaries stay tracked.
/results/stage2d2/confirmatory_basin/checkpoints/
/results/stage2d2/**/*.log
# Stage 2D.3 baseline/curriculum checkpoints and process logs are reproducible
# from the tracked protocol, seeds and training scripts. Compact run-level
# anatomy, causal, gate and dynamics summaries remain versioned.
/results/stage2d3/**/checkpoints/
/results/stage2d3/**/*.log
# Stage 2D.4 checkpoints, per-run audit payloads, and process logs are
# reproducible from tracked seeds/scripts. Compact adjudication JSON remains.
/results/stage2d4/checkpoints/
/results/stage2d4/audits/
/results/stage2d4/logs/
# Stage 2D.5 reproducible confirmatory checkpoints and process logs remain
# on the research server. Run-level JSON, pilot and final reports are tracked.
/results/stage2d5/confirmatory/checkpoints/
/results/stage2d5/confirmatory/logs/
/results/stage2d5/path_restoration/*.log
# Stage 2D.6 confirmatory C0 checkpoints and process logs are reproducible
# from the tracked frozen training protocol, seeds and summaries.
/results/stage2d6/confirmatory/checkpoints/
/results/stage2d6/**/*.log
# Stage 2D.7 binaries and process logs are reproducible from the tracked
# seeds/protocols. Keep model-level JSON diagnostics, manifests and reports.
/results/stage2d7/**/*.pt
/results/stage2d7/**/*.log
/results/stage2d7/smoke/
/results/stage2d7/processed/partial_summary_stdout.json
/results/stage2d7/processed/*_stdout.json
